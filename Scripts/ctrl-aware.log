#Requires AutoHotkey v2.0

; Set coordinate mode
CoordMode "Mouse", "Screen"  ; Changed to screen mode

; Global variables
normalSpeed := 15
turboSpeed := 30

; Basic navigation
CapsLock & k::{ ; Down
    if GetKeyState("Ctrl", "P")
        Send "^k"
    else
        Send "{Down}"
}
CapsLock & j::{ ; Up
    if GetKeyState("Ctrl", "P")
        Send "^j"
    else
        Send "{Up}"
}
CapsLock & h::{ ; Left
    if GetKeyState("Ctrl", "P")
        Send "^h"
    else
        Send "{Left}"
}
CapsLock & l::{ ; Right
    if GetKeyState("Ctrl", "P")
        Send "^l"
    else
        Send "{Right}"
}
CapsLock & u::{ ; Page Up
    if GetKeyState("Ctrl", "P")
        Send "^u"
    else
        Send "{PgUp}"
}
CapsLock & o::{ ; Page Down
    if GetKeyState("Ctrl", "P")
        Send "^o"
    else
        Send "{PgDn}"
}
CapsLock & i::{ ; Scroll Up
    if GetKeyState("Ctrl", "P")
        Send "^i"
    else
        Send "{WheelUp}"
}
CapsLock & m::{ ; Scroll Down
    if GetKeyState("Ctrl", "P")
        Send "^m"
    else
        Send "{WheelDown}"
}

; Mouse clicks
CapsLock & q::{
    if GetKeyState("Ctrl", "P")
        Send "^q"
    else {
        Send "{LButton down}"
        KeyWait "q"
        Send "{LButton up}"
    }
}

CapsLock & Enter::{
    if GetKeyState("Ctrl", "P")
        Send "^{Enter}"
    else {
        Send "{LButton down}"
        KeyWait "Enter"
        Send "{LButton up}"
    }
}

CapsLock & e::{
    if GetKeyState("Ctrl", "P")
        Send "^e"
    else {
        Send "{RButton down}"
        KeyWait "e"
        Send "{RButton up}"
    }
}

; Mouse movement - Combined directions
CapsLock & a::{  ; Left and potential diagonal
    if GetKeyState("Ctrl", "P")
        Send "^a"
    else {
        while GetKeyState("a", "P") {
            speed := GetKeyState("RShift", "P") ? turboSpeed : normalSpeed
            x := -speed
            y := 0
            
            ; Check for diagonal movement
            if GetKeyState("w", "P")  ; Up-Left
                y := -speed
            else if GetKeyState("s", "P")  ; Down-Left
                y := speed
                
            MouseMove x, y, , "R"
            Sleep 50
        }
    }
}

CapsLock & d::{  ; Right and potential diagonal
    if GetKeyState("Ctrl", "P")
        Send "^d"
    else {
        while GetKeyState("d", "P") {
            speed := GetKeyState("RShift", "P") ? turboSpeed : normalSpeed
            x := speed
            y := 0
            
            ; Check for diagonal movement
            if GetKeyState("w", "P")  ; Up-Right
                y := -speed
            else if GetKeyState("s", "P")  ; Down-Right
                y := speed
                
            MouseMove x, y, , "R"
            Sleep 50
        }
    }
}

CapsLock & w::{  ; Up and potential diagonal
    if GetKeyState("Ctrl", "P")
        Send "^w"
    else {
        while GetKeyState("w", "P") {
            speed := GetKeyState("RShift", "P") ? turboSpeed : normalSpeed
            x := 0
            y := -speed
            
            ; Check for diagonal movement
            if GetKeyState("a", "P")  ; Up-Left
                x := -speed
            else if GetKeyState("d", "P")  ; Up-Right
                x := speed
                
            MouseMove x, y, , "R"
            Sleep 50
        }
    }
}

CapsLock & s::{  ; Down and potential diagonal
    if GetKeyState("Ctrl", "P")
        Send "^s"
    else {
        while GetKeyState("s", "P") {
            speed := GetKeyState("RShift", "P") ? turboSpeed : normalSpeed
            x := 0
            y := speed
            
            ; Check for diagonal movement
            if GetKeyState("a", "P")  ; Down-Left
                x := -speed
            else if GetKeyState("d", "P")  ; Down-Right
                x := speed
                
            MouseMove x, y, , "R"
            Sleep 50
        }
    }
}


